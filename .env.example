# Copy this file to .env and fill in your key. .env is gitignored - never commit real keys.
# The agent runs fully offline by default; the key is only used when AGENT_USE_LLM=1.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown)
# AGENT_USE_LLM=0            1 = phrase the customer-facing message with OpenAI (never affects ranking)
# OPENAI_MODEL=gpt-4o-mini
# AGENT_USE_EMBEDDINGS=0     1 = dense tier from a local sentence-transformer + cached catalog matrix
# AGENT_MODEL_PATH=models/all-MiniLM-L6-v2
# AGENT_CATALOG_PATH=data/catalog.jsonl
# AGENT_ASK_POLICY=other     other | value
# AGENT_CONFIDENCE_GATE=1    0 = always return the full top-10 (see README "Confidence gate")
